---
const { title = "UD. Dikha Jalak Suren Bali", description = "Informasi UD. Dikha Jalak Suren Bali, toko burung di Dalung, Badung, Bali." } = Astro.props;
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <title>{title}</title>
    <style is:global>
      :root { font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; color: #242424; background: #fff; }
      * { box-sizing: border-box; }
      body { margin: 0; line-height: 1.7; }
      a { color: inherit; text-decoration-thickness: 1px; text-underline-offset: 4px; }
      .wrap { width: min(760px, calc(100% - 40px)); margin: 0 auto; }
      header { padding: 24px 0; border-bottom: 1px solid #eee; }
      .brand { font-weight: 750; text-decoration: none; font-size: 1.08rem; }
      nav { display: flex; flex-wrap: wrap; gap: 18px; margin-top: 10px; font-size: .95rem; color: #555; }
      main { padding: 46px 0 72px; min-height: 65vh; }
      h1 { font-size: clamp(2rem, 6vw, 3.25rem); line-height: 1.12; letter-spacing: -.04em; }
      h2 { line-height: 1.3; }
      .muted, time { color: #777; font-size: .94rem; }
      .hero { padding: 26px 0 36px; }
      .eyebrow { color: #666; font-size: .82rem; font-weight: 700; letter-spacing: .12em; }
      .actions { display: flex; flex-wrap: wrap; gap: 12px; margin: 26px 0; }
      .button { display: inline-block; padding: 11px 17px; border: 1px solid #222; border-radius: 6px; text-decoration: none; font-weight: 650; }
      .button.primary { background: #222; color: white; }
      .panel { border: 1px solid #e8e8e8; border-radius: 10px; padding: 20px; margin: 20px 0; }
      .details { display: grid; gap: 14px; }
      .details p { margin: 0; }
      .post { padding: 22px 0; border-bottom: 1px solid #eee; }
      .post h2 { margin: 5px 0; font-size: 1.3rem; }
      .post h2 a { text-decoration: none; }
      .post p { margin: 6px 0; color: #666; }
      footer { border-top: 1px solid #eee; padding: 24px 0 36px; color: #777; font-size: .9rem; }
      .content p { margin: 1.2em 0; }
    </style>
  </head>
  <body>
    <header>
      <div class="wrap">
        <a class="brand" href="/">UD. Dikha Jalak Suren Bali</a>
        <nav aria-label="Navigasi utama">
          <a href="/">Beranda</a>
          <a href="/about/">Tentang</a>
          <a href="/kontak/">Kontak & Lokasi</a>
          <a href="/blog/">Artikel</a>
        </nav>
      </div>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer><div class="wrap">UD. Dikha Jalak Suren Bali · Dalung, Badung, Bali</div></footer>
  </body>
</html>
