---
const { title = "Uji Astro Blog", description = "Blog minimal berbasis Astro." } = Astro.props;
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <title>{title}</title>
    <style is:global>
      :root { font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; color: #242424; background: #fff; }
      * { box-sizing: border-box; }
      body { margin: 0; line-height: 1.7; }
      a { color: inherit; text-decoration-thickness: 1px; text-underline-offset: 4px; }
      .wrap { width: min(720px, calc(100% - 40px)); margin: 0 auto; }
      header { padding: 28px 0; border-bottom: 1px solid #eee; }
      .brand { font-weight: 700; text-decoration: none; }
      nav { display: flex; gap: 20px; margin-top: 10px; font-size: .95rem; color: #555; }
      main { padding: 56px 0 80px; min-height: 65vh; }
      h1 { font-size: clamp(2rem, 6vw, 3rem); line-height: 1.15; letter-spacing: -.04em; }
      h2 { line-height: 1.3; }
      .muted, time { color: #777; font-size: .92rem; }
      .post { padding: 22px 0; border-bottom: 1px solid #eee; }
      .post h2 { margin: 5px 0; font-size: 1.35rem; }
      .post h2 a { text-decoration: none; }
      .post p { margin: 6px 0; color: #666; }
      footer { border-top: 1px solid #eee; padding: 24px 0 36px; color: #777; font-size: .9rem; }
      .content p { margin: 1.2em 0; }
    </style>
  </head>
  <body>
    <header>
      <div class="wrap">
        <a class="brand" href="/">Uji Astro Blog</a>
        <nav aria-label="Navigasi utama">
          <a href="/">Beranda</a>
          <a href="/blog/">Blog</a>
          <a href="/about/">Tentang</a>
        </nav>
      </div>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer><div class="wrap">Dibuat dengan Astro · Diterbitkan melalui Cloudflare Pages</div></footer>
  </body>
</html>
